{
  "manifest_version": 3,
  "name": "Relay Load Fetcher",
  "version": "0.2",
  "description": "Fetches loads from Amazon Relay load board",
  "permissions": ["activeTab", "cookies", "alarms"],
  "host_permissions": [
    "https://relay.amazon.com/*",
    "https://discord.com/api/webhooks/*",
    "https://discordapp.com/api/webhooks/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://relay.amazon.com/loadboard/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["Sounds/*", "interceptor.js"],
      "matches": ["https://relay.amazon.com/*"]
    }
  ]
}
